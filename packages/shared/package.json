  },
  "peerDependencies": {
    "viem": "^2.21.0"
  },
  "peerDependenciesMeta": {
    "viem": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "viem": "^2.21.0"
  }
