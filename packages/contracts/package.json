{
  "name": "@corolary/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "forge build",
    "test": "forge test -vvv",
    "clean": "forge clean && rm -rf .turbo",
    "abi": "node scripts/export-abi.mjs",
    "deploy:testnet": "forge script script/Deploy.s.sol --rpc-url cc3-testnet --broadcast --slow --gas-estimate-multiplier 800 --verify --verifier blockscout --verifier-url https://creditcoin-testnet.blockscout.com/api",
    "verify:pending": "forge script script/Deploy.s.sol --rpc-url cc3-testnet --resume --verify --verifier blockscout --verifier-url https://creditcoin-testnet.blockscout.com/api",
    "deploy:simulate": "forge script script/Deploy.s.sol --rpc-url cc3-testnet"
  },
  "dependencies": {
    "@gluwa/usc-contracts": "0.2.0",
    "@openzeppelin/contracts": "^5.1.0"
  }
}
