# Corolary — SATU file .env untuk seluruh repo.
#
# Kontrak (Foundry), indexer, API, dan frontend semuanya membaca file ini.
# Jangan pernah membuat .env kedua di apps/web atau services/* — dua file env
# yang harus disinkronkan manual adalah bug konfigurasi yang baru ketahuan saat
# demo. `pnpm env:link` menyambungkan apps/web/.env.local ke file ini sebagai
# symlink, dan `pnpm dev:web` memanggilnya otomatis.
#
# Salin ke `.env` lalu isi. `.env` TIDAK PERNAH di-commit.
# Referensi: docs/architecture.md §15, docs/setup.md §4.

# ── Ethereum (source chain) ──────────────────────────────────────────
# WAJIB archive-capable DAN sanggup eth_getLogs rentang lebar.
# Dua syarat terpisah — provider bisa lulus yang pertama tapi gagal yang kedua.
#
# Diukur ulang 2026-09-08, setelah drpc free RUNTUH dari 3.000 blok ke ~50
# (lihat CLAUDE.md). Semua di bawah TANPA API key:
#   mevblocker  archive s/d blok 19jt OK  getLogs 5.000 blok OK  batch 12 OK
#               (cocok SIDIK JARI dengan drpc di jendela 46 blok — bukan
#                sekadar jumlah log yang sama, tapi himpunan log yang sama)
#   flashbots   jawaban benar tapi sering kosong/rate-limited — jangan diandalkan
#   drpc        getLogs TURUN ke ~50 blok; masih berguna sebagai CADANGAN
#   Alchemy free  getLogs DIBATASI 10 BLOK (inklusif) — lebih sempit dari drpc
#   publicnode  archive butuh token
#   ankr        butuh API key
#   1rpc        getLogs maks 50 blok
#   llamarpc    MENGEMBALIKAN 0 LOG TANPA ERROR — jangan dipakai, lihat CLAUDE.md
#
# Batas mevblocker yang terukur: hard cap 10.000 blok per permintaan, dan
# "query returned more than 10000 results" pada kontrak padat. Karena itu
# chunkSize tetap PER PROTOKOL di watcher/protocols.ts, bukan global.
ETHEREUM_RPC_URL=https://rpc.mevblocker.io
# Cadangan. Dipakai otomatis kalau yang utama gagal — TAPI kemampuannya tidak
# setara: drpc free kini menolak eth_getLogs di atas ~50 blok, jadi watcher
# berjalan DEGRADASI (rentang dipecah) alih-alih normal. Semua metode lain
# dilayani penuh. Kosongkan kalau tidak ada; tanpa ini tidak ada failover.
ETHEREUM_RPC_URL_FALLBACK=https://eth.drpc.org
ETHEREUM_CHAIN_KEY=3

# ── Creditcoin CC3 Testnet ───────────────────────────────────────────
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network

# Jalur WebSocket ke node CC3 yang SAMA. Opsional — kalau kosong, diturunkan
# dari CREDITCOIN_RPC_URL dengan menukar http->ws.
#
# Gunanya satu: nginx di depan RPC HTTP memotong body di 1 MiB (terukur
# 2026-09-12 — 1.048.575 byte lolos, 1.048.577 dijawab 413), dan karena body
# eth_sendRawTransaction adalah heks, plafon itu jatuh jadi ~491 KB pada
# calldata. Fakta dengan receipt besar mustahil dikirim lewat HTTP dan mati
# permanen. WS tidak lewat client_max_body_size; frame 8 MB diterima.
CREDITCOIN_WS_URL=
CREDITCOIN_CHAIN_ID=102031
PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network

# Dompet yang mengirim recordFact. Pisahkan dari dompet deployer —
# indexer mengirim transaksi terus-menerus, deployer memegang ownership.
SUBMITTER_PRIVATE_KEY=
# Alamat dompet di atas. Script Deploy.s.sol membacanya lewat vm.envAddress
# untuk memberi RECORDER_ROLE — Foundry tidak bisa menurunkan alamat dari
# private key di dalam script.
SUBMITTER_ADDRESS=
# Dompet yang men-deploy kontrak (hanya dipakai saat deploy).
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=

# ── Alamat kontrak (diisi setelah deploy) ────────────────────────────
FACT_REGISTRY_ADDRESS=
PRICE_REGISTRY_ADDRESS=
CREDIT_GRAPH_ADDRESS=
EFFICIENCY_MARKET_ADDRESS=

# Adapter protokol (dicetak oleh script Deploy.s.sol)
AAVE_V3_ADAPTER_ADDRESS=
SPARK_ADAPTER_ADDRESS=
MORPHO_BLUE_ADAPTER_ADDRESS=
COMPOUND_V3_ADAPTER_ADDRESS=

# Token testnet pasar (open-issues B2 — token stand-in, harga mainnet sungguhan)
TEST_USDC_ADDRESS=
TEST_WETH_ADDRESS=

# ── Infrastruktur ────────────────────────────────────────────────────
DATABASE_URL=postgres://corolary:corolary_dev@localhost:5432/corolary
API_PORT=8080

# ── Frontend ─────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
# Tautan explorer untuk setiap fakta dan transaksi. WAJIB terisi sebelum submit:
# tanpa ini langkah ④ ProofChain — momen yang membuktikan seluruh klaim produk
# di video demo — mengarah ke mana-mana.
NEXT_PUBLIC_CREDITCOIN_EXPLORER_URL=https://creditcoin-testnet.blockscout.com
# Alamat yang sama dengan EFFICIENCY_MARKET_ADDRESS di atas, diulang dengan
# awalan NEXT_PUBLIC_ karena Next hanya menyuntikkan variabel berawalan itu ke
# bundel klien. Tanpa ini frontend tidak punya alamat untuk dikirimi transaksi
# supply/borrow/repay — dan gejalanya bukan error konfigurasi melainkan tombol
# yang tampak normal lalu gagal saat diklik.
NEXT_PUBLIC_EFFICIENCY_MARKET_ADDRESS=
# Opsional. Kosong berarti frontend hanya memakai connector injected (MetaMask
# dkk), yang berfungsi penuh — WalletConnect dengan projectId kosong justru
# gagal saat runtime, jadi biarkan kosong sampai benar-benar punya id.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Alamat kontrak yang ditampilkan di footer landing supaya siapa pun bisa
# memeriksa sendiri di Blockscout. Hanya dibaca, tidak pernah ditulis.
# EFFICIENCY_MARKET sudah ada di atas.
NEXT_PUBLIC_FACT_REGISTRY_ADDRESS=
NEXT_PUBLIC_CREDIT_GRAPH_ADDRESS=
NEXT_PUBLIC_PRICE_REGISTRY_ADDRESS=

# Dompet yang ditampilkan di landing sebagai bukti hidup. Alamat mainnet NYATA
# dengan riwayat terbukti — bukan contoh. Kunci privatnya bukan milik tim
# (open-issues B5), jadi ia tidak pernah meminjam di pasar; karena itu landing
# menampilkan RASIO kolateralnya, bukan capitalSavedUsd yang di sini memang nol.
NEXT_PUBLIC_FEATURED_ADDRESS=

# HARUS false di produksi. `pnpm check:no-mocks` menegakkan ini sebelum submit.
NEXT_PUBLIC_USE_FIXTURES=false

# Akun X proyek, dipakai ikon di footer landing. Selama kosong, ikonnya
# menunjuk ke beranda x.com, yang termuat tapi bukan akun kita. Isi sebelum
# submit.
NEXT_PUBLIC_X_URL=
