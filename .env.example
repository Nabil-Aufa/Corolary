# Corolary — SATU file .env untuk seluruh repo.
#
# Kontrak (Foundry), indexer, API, dan frontend semuanya membaca file ini.
# Jangan pernah membuat .env kedua di apps/web atau services/* — dua file env
# yang harus disinkronkan manual adalah bug konfigurasi yang baru ketahuan saat
# demo. `pnpm env:link` menyambungkan apps/web/.env.local ke file ini sebagai
# symlink, dan `pnpm dev:web` memanggilnya otomatis.
#
# Salin ke `.env` lalu isi. `.env` TIDAK PERNAH di-commit.
# Referensi: docs/architecture.md §15, docs/setup.md §4.

# ── Ethereum (source chain) ──────────────────────────────────────────
# WAJIB archive-capable (Alchemy/Infura/QuickNode).
# RPC publik MENOLAK query log historis — sudah diuji dan gagal.
ETHEREUM_RPC_URL=
# 3 = Ethereum MAINNET dibaca dari CC3 Testnet. Jangan pakai 1 (Sepolia)
# untuk produk akhir — itu melanggar aturan nol-mock.
ETHEREUM_CHAIN_KEY=3

# ── Creditcoin CC3 Testnet ───────────────────────────────────────────
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
CREDITCOIN_CHAIN_ID=102031
PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network

# Dompet yang mengirim recordFact. Pisahkan dari dompet deployer —
# indexer mengirim transaksi terus-menerus, deployer memegang ownership.
SUBMITTER_PRIVATE_KEY=
# Dompet yang men-deploy kontrak (hanya dipakai saat deploy).
DEPLOYER_PRIVATE_KEY=

# ── Alamat kontrak (diisi setelah deploy) ────────────────────────────
FACT_REGISTRY_ADDRESS=
PRICE_REGISTRY_ADDRESS=
CREDIT_GRAPH_ADDRESS=
EFFICIENCY_MARKET_ADDRESS=

# Adapter protokol (dicetak oleh script Deploy.s.sol)
AAVE_V3_ADAPTER_ADDRESS=
SPARK_ADAPTER_ADDRESS=
MORPHO_BLUE_ADAPTER_ADDRESS=
COMPOUND_V3_ADAPTER_ADDRESS=

# ── Infrastruktur ────────────────────────────────────────────────────
DATABASE_URL=postgres://corolary:corolary_dev@localhost:5432/corolary
API_PORT=8080

# ── Frontend ─────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
# HARUS false di produksi. `pnpm check:no-mocks` menegakkan ini sebelum submit.
NEXT_PUBLIC_USE_FIXTURES=false
