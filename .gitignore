# ── RAHASIA — jangan pernah ter-commit ────────────────────────────────
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# ── arsip ─────────────────────────────────────────────────────────────
*.tar.gz
*.tgz
*.zip

# ── dependency & build ────────────────────────────────────────────────
node_modules/
dist/
build/
out/
cache/
artifacts/
broadcast/
coverage/
.next/
.turbo/

# ── Foundry ───────────────────────────────────────────────────────────
lib/
# forge-std adalah git submodule — gitlink-nya HARUS ikut ter-commit, kalau
# tidak `forge build` gagal di mesin lain. Clone: git submodule update --init
!packages/contracts/lib/forge-std
cache_forge/

# ── worker ────────────────────────────────────────────────────────────
packages/worker/data/
*.sqlite
*.sqlite-journal

# ── OS & editor ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# ── log ───────────────────────────────────────────────────────────────
*.log
npm-debug.log*
